  ---

  <header id="header">
    <nav>
      <button aria-expanded="false" aria-controls="main-menu" aria-label="Open main menu" class="menu">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
      <div id="main-menu">
        <a href="/">Accueil</a>
        <a href="/about/">À propos</a>
        <a href="/spinoza-et-desargues">Spinoza & Desargues</a>
        <a href="/perspectives/">Perspectives</a>
        <a href="/vermeer/">Vermeer</a>
        <a href="/texts/">Articles</a>
      </div>
    </nav>
  </header>

  <style lang="scss">
    @use "../styles/_variables";


    header {
      position: sticky;
      top: 0;
      z-index: variables.$z-index-ten;

      & > nav {
        position: relative;
        padding: 10px;

        & > button.menu {
          position: relative;
          display: flex;
          flex-direction: column;
          justify-content: center;
          background-color: variables.$twilight-indigo;
          border: none;
          border-radius: 50%;
          font-weight: bold;
          width: 48px;
          height: 48px;
          box-shadow: variables.$normal-shadow;
          z-index: variables.$z-index-two;

          &[aria-expanded="true"] {
            box-shadow: none;
            background-color: variables.$lobster-pink;

            /* burger transform */
            & > span:nth-child(1) {
              transform: translateY(8px) rotate(45deg);
              background: variables.$twilight-indigo;
            }
            & > span:nth-child(2) {
              opacity: 0;
            }
            & > span:nth-child(3) {
              transform: translateY(-8px) rotate(-45deg);
              background: variables.$twilight-indigo;
            }
          }

          & > span {
            display: block;
            width: 22px;
            height: 2px;
            background: white;
            border-radius: 1px;
            margin: 3px auto;
            transition: all 0.3s ease;
          }
        }

        & > div {
          display: none;
          width: 100%;
          margin: 0;
          background-color: variables.$twilight-indigo;

          & > a {
            display: block;
            text-align: center;
            text-decoration: none;
            font-size: variables.$font-size-body;
            font-family: variables.$font-family-body;
            color: white;
            text-transform: uppercase;
            padding: 0.5rem;

            &:hover, &:focus {
              background-color: variables.$lobster-pink;
            }
          }
        }
      }

      &:has(.menu[aria-expanded="true"]) {
        #main-menu {
          display: block;
          flex-direction: column;
          position: absolute;
          top: 0;
          left: 0;
          z-index: variables.$z-index-zero;
          box-shadow: variables.$normal-shadow;
        }
      }
    }
    
    @media screen and (min-width: variables.$tablet-size) {
      header {
        transition: box-shadow 0.2s ease;

        &.scrolled {
          box-shadow: variables.$bottom-shadow;
        }

        & > nav {
          padding: 0;

          & > button.menu {
            display: none;
          }

          & > div {
            width: 100%;
            display: block;
            text-align: center;

            & > a {
              display: inline-block;
              padding: 1rem;
            }
          }
        }
      }
    }
  </style>

  <script>
    import "../scripts/mobile-menu.ts";
    import "../scripts/menu-scroll.ts";
  </script>